'三ツ星ホテル':'学校をつくっちゃおう：1度きりセット#1／直接購入480ダイヤ',
'温泉旅館':'学校をつくっちゃおう：1度きりセット#1／直接購入480ダイヤ',
'牧場':'学校をつくっちゃおう：1度きりセット#1／直接購入480ダイヤ'
};
function info(name){let a=[];if(DIRECT[name]){const [day,price]=DIRECT[name];a.push('💎 直接購入：毎月'+day+'日／'+price+'ダイヤ');}if(SETS[name])a.push('🛍️ 恒常セット：'+SETS[name]);if(WEEKLY[name])a.push('📅 曜日限定：'+WEEKLY[name]);if(EVENTS[name])a.push('🎪 期間限定：'+EVENTS[name]);a.push('🔓 ロック中でも、ショップの研究・ダイヤ購入・となり町ノルマなどで解除できる場合があります。');return a}
function showInfo(name){let el=document.getElementById('buildingInfo');el.style.display='block';el.innerHTML='<b>🏢 '+name+'</b>'+info(name).map(x=>'<div class="method">'+x+'</div>').join('')+'<small>※直接購入・恒常セット・曜日限定・期間限定の情報は攻略Wiki掲載情報を基準にしています。価格はセール等で変動する場合があります。</small>'}
function renderRanking(){let have=ownedList();let freq={};DATA.forEach(r=>r.slice(1,4).forEach(b=>freq[norm(b)]=(freq[norm(b)]||0)+1));let arr=DATA.map(r=>{let bs=r.slice(1,4),n=bs.filter(b=>have.includes(norm(b))).length,score=r[4]+r[5];return {r,bs,n,score}}).sort((a,b)=>b.score-a.score||b.r[4]-a.r[4]).slice(0,10);let out='';arr.forEach((x,i)=>{let st=x.n===3?'完成':x.n===2?'あと1軒':x.n===1?'あと2軒':'';out+='<div class="result"><div class="name">'+(i+1)+'. '+x.r[0]+(st?'<span class="rank">'+st+'</span>':'')+'</div><div class="buildings">'+x.bs.map(b=>'<button class="tag '+(have.includes(norm(b))?'':'missing')+'" data-building="'+b.replaceAll('"','&quot;')+'">'+b+'</button>').join('')+'</div><div class="stats">地価 +'+x.r[4]+'%　商品価格 +'+x.r[5]+'%　総合効果 '+x.score+'%</div></div>'});document.getElementById('ranking').innerHTML=out;renderBeginnerRanking(have,freq)}
function accessLevel(b){
  if(SETS[b]) return 3; // ランクFの常設セットを確認できる建物
  if(DIRECT[b]){
    const price=Number(DIRECT[b][1])||9999;
    return price<=100?2:1;
  }
  if(WEEKLY[b]||EVENTS[b]) return 1;
  return 0;
}
function accessLabel(level){return level===3?'🟢 常設セットあり':level===2?'🟢 直接購入しやすい':level===1?'🟡 条件・費用あり':'🔴 入手方法を要確認'}
function beginnerScore(x){
  const levels=x.bs.map(accessLevel);
  const min=Math.min(...levels), sum=levels.reduce((a,b)=>a+b,0);
  // 所持状況を最優先。次に「3軒とも恒常セットで狙えるか」を重視。
  return x.owned*300 + sum*55 + x.r[4] + x.r[5] - (min===0?180:0) - (min===1?45:0);
}
function renderBeginnerRanking(have,freq){
  let arr=DATA.map(r=>{
    let bs=r.slice(1,4), owned=bs.filter(b=>have.includes(norm(b))).length;
    let levels=bs.map(accessLevel), min=Math.min(...levels), common=bs.reduce((s,b)=>s+(freq[norm(b)]||0),0), effect=r[4]+r[5];
    let x={r,bs,owned,levels,min,common,effect}; x.score=beginnerScore(x); return x;
  });
  const easy=arr.filter(x=>x.min>=3).sort((a,b)=>b.score-a.score||b.owned-a.owned||b.effect-a.effect).slice(0,7);
  const mid=arr.filter(x=>x.min>=1&&x.min<3).sort((a,b)=>b.score-a.score||b.owned-a.owned||b.effect-a.effect).slice(0,5);
  const hard=arr.filter(x=>x.min===0).sort((a,b)=>b.effect-a.effect||b.owned-a.owned).slice(0,5);
  const card=(x,i)=>{
    let st=x.owned===3?'完成':x.owned===2?'あと1軒':x.owned===1?'あと2軒':'未所持';
    let methods=x.bs.map((b,j)=>accessLabel(x.levels[j])).join(' / ');
    return '<div class="result"><div class="name">'+(i+1)+'. '+x.r[0]+'<span class="rank">'+st+'</span></div><div class="buildings">'+x.bs.map(b=>'<button class="tag '+(have.includes(norm(b))?'':'missing')+'" data-building="'+b.replaceAll('"','&quot;')+'">'+b+'</button>').join('')+'</div><div class="stats">地価 +'+x.r[4]+'%　商品価格 +'+x.r[5]+'%　｜ '+methods+'</div></div>';
  };
  let out='<div class="help"><b>判定基準</b>：ランクFの常設セットで確認できる建物を最優先。直接購入や条件付き入手は次点、入手方法を確認できない建物は序盤ランキングから外して「後回し」にしています。</div>';
  out+='<h3 style="margin:14px 0 6px">🟢 今すぐ狙いやすい</h3>'+(easy.length?easy.map(card).join(''):'<div class="empty">現在の条件では該当なし</div>');
  out+='<h3 style="margin:14px 0 6px">🟡 少し進めてから</h3>'+(mid.length?mid.map(card).join(''):'<div class="empty">現在の条件では該当なし</div>');
  out+='<h3 style="margin:14px 0 6px">🔴 序盤は後回し</h3>'+(hard.length?hard.map(card).join(''):'<div class="empty">該当なし</div>');
  document.getElementById('beginnerRanking').innerHTML=out;
}
function render(){let q=norm(document.getElementById('q').value), have=ownedList(), mode=document.getElementById('sort').value;let arr=DATA.map(r=>({r,bs:r.slice(1,4),hit:r[0].includes(q)||r.slice(1,4).some(x=>norm(x).includes(q))})).filter(x=>!q||x.hit).map(x=>{let n=x.bs.filter(b=>have.includes(norm(b))).length;return {...x,n,miss:x.bs.filter(b=>!have.includes(norm(b)))}});arr.sort((a,b)=>mode==='name'?a.r[0].localeCompare(b.r[0],'ja'):mode==='land'?b.r[4]-a.r[4]:mode==='price'?b.r[5]-a.r[5]:b.n-a.n||b.r[4]-a.r[4]);document.getElementById('count').textContent=(q?'検索結果 ':'専門街一覧 ')+arr.length+'件';let out='';for(const x of arr){let status=x.n===3?'完成':x.n===2?'あと1軒':x.n===1?'あと2軒':'';out+='<div class="result"><div class="name">'+x.r[0]+(status?'<span class="rank">'+status+'</span>':'')+'</div><div class="buildings">'+x.bs.map(b=>'<button class="tag '+(have.includes(norm(b))?'':'missing')+'" data-building="'+b.replaceAll('"','&quot;')+'">'+b+'</button>').join('')+'</div><div class="stats">地価 +'+x.r[4]+'%　商品価格 +'+x.r[5]+'%</div></div>'}document.getElementById('results').innerHTML=out||'<div class="empty">該当する専門街がありません。</div>';renderRanking()}
function searchNow(){let q=document.getElementById('q').value.trim();if(q){let exact=DATA.flatMap(r=>r.slice(1,4)).find(b=>norm(b)===norm(q));showInfo(exact||q);}else{document.getElementById('buildingInfo').style.display='none';}render()}document.getElementById('searchBtn').onclick=searchNow;document.getElementById('q').oninput=e=>{let v=e.target.value.trim();if(v){let exact=DATA.flatMap(r=>r.slice(1,4)).find(b=>norm(b)===norm(v));showInfo(exact||v);}else{document.getElementById('buildingInfo').style.display='none';}render()};document.getElementById('q').onkeydown=e=>{if(e.key==='Enter')searchNow()};document.getElementById('sort').onchange=render;document.getElementById('owned').oninput=render;document.querySelectorAll('[data-q]').forEach(b=>b.onclick=()=>{document.getElementById('q').value=b.dataset.q;searchNow()});document.getElementById('results').onclick=e=>{let b=e.target.closest('[data-building]');if(b){document.getElementById('q').value=b.dataset.building;showInfo(b.dataset.building);render()}};document.getElementById('ranking').onclick=e=>{let b=e.target.closest('[data-building]');if(b){document.getElementById('q').value=b.dataset.building;showInfo(b.dataset.building);render();document.getElementById('rankingBox').open=false;window.scrollTo({top:0,behavior:'smooth'});}};document.getElementById('beginnerRanking').onclick=e=>{let b=e.target.closest('[data-building]');if(b){document.getElementById('q').value=b.dataset.building;showInfo(b.dataset.building);render();document.getElementById('beginnerBox').open=false;window.scrollTo({top:0,behavior:'smooth'});}};render();
</script></body></html>
